[Unit]
Description=Yinghuo remote MCP HTTP (Bearer)
After=yinghuo-earth.service
Wants=yinghuo-earth.service

[Service]
Type=simple
WorkingDirectory=/opt/yinghuo
Environment=PATH=/usr/bin:/bin
Environment=HOME=/root
Environment=DTN_RELAY_URL=http://127.0.0.1:3101
Environment=YINGHUO_MCP_HTTP_PORT=3110
EnvironmentFile=-/etc/yinghuo/mcp.env
ExecStart=/usr/bin/npm run start:http -w @yinghuo/mcp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
