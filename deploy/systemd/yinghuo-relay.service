[Unit]
Description=Yinghuo DTN Relay node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/yinghuo
Environment=PATH=/usr/bin:/bin
Environment=HOME=/root
ExecStart=/usr/bin/npm run start:relay -w @yinghuo/relay
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
