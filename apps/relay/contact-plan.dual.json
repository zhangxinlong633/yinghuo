{
  "description": "Dual-relay Earth↔Mars wall-clock contact plan（双中继演示）",
  "mode": "dual",
  "scale": "Wall-clock cyclic: period 20s, open [5s,15s) within each period — store during gap, forward when open",
  "nodes": [
    {
      "name": "Earth",
      "role": "endpoint",
      "port": 3101,
      "peerUrl": "http://127.0.0.1:3102",
      "nextHop": { "Mars": "Mars" }
    },
    {
      "name": "Mars",
      "role": "endpoint",
      "port": 3102,
      "peerUrl": "http://127.0.0.1:3101",
      "nextHop": { "Earth": "Earth" }
    }
  ],
  "contacts": [
    {
      "a": "Earth",
      "b": "Mars",
      "delayMs": 200,
      "bandwidthBps": 1000000,
      "schedule": {
        "type": "cyclic",
        "periodMs": 20000,
        "openOffsetMs": 5000,
        "openDurationMs": 10000
      }
    }
  ],
  "application": {
    "src": "Earth",
    "dst": "Mars",
    "payload": "Hello Mars via dual-relay",
    "ttlMs": 120000
  }
}
