{
  "name": "@yinghuo/relay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:earth": "NODE_ID=Earth PORT=3101 tsx src/main.ts",
    "start:relay": "NODE_ID=Relay PORT=3103 tsx src/main.ts",
    "start:mars": "NODE_ID=Mars PORT=3102 tsx src/main.ts",
    "start:earth:long": "CONTACT_PLAN=contact-plan.tri-long.json NODE_ID=Earth PORT=3101 tsx src/main.ts",
    "start:relay:long": "CONTACT_PLAN=contact-plan.tri-long.json NODE_ID=Relay PORT=3103 tsx src/main.ts",
    "start:mars:long": "CONTACT_PLAN=contact-plan.tri-long.json NODE_ID=Mars PORT=3102 tsx src/main.ts",
    "start:earth:abs": "CONTACT_PLAN=contact-plan.tri-absolute.json NODE_ID=Earth PORT=3101 tsx src/main.ts",
    "start:relay:abs": "CONTACT_PLAN=contact-plan.tri-absolute.json NODE_ID=Relay PORT=3103 tsx src/main.ts",
    "start:mars:abs": "CONTACT_PLAN=contact-plan.tri-absolute.json NODE_ID=Mars PORT=3102 tsx src/main.ts",
    "smoke": "bash scripts/smoke-all.sh",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:live": "DTN_LIVE_SMOKE=1 node --import tsx --test src/live-tri-smoke.test.ts",
    "native:build": "cd ../../native/bp-codec && (test -f build/libdtn_bp_codec.dylib || test -f build/libdtn_bp_codec.so || (./scripts/fetch-deps.sh && cmake -S . -B build && cmake --build build))"
  },
  "dependencies": {
    "@yinghuo/core": "*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "classic-level": "^3.0.0",
    "koffi": "^3.3.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
