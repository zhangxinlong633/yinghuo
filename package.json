{
  "name": "yinghuo",
  "version": "1.0.0",
  "private": true,
  "description": "DTN 萤火束递网 — DTN Yinghuo Bundle Delivery Fabric (Nest relay + CLI/SDK + console)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @yinghuo/core && npm run build -w @yinghuo/sdk && npm run build -w @yinghuo/relay && npm run build -w @yinghuo/api && npm run build -w @yinghuo/web",
    "demo": "npm run demo -w @yinghuo/core",
    "demo:plan": "npm run demo:plan -w @yinghuo/core",
    "relay:earth": "npm run start:earth -w @yinghuo/relay",
    "relay:relay": "npm run start:relay -w @yinghuo/relay",
    "relay:mars": "npm run start:mars -w @yinghuo/relay",
    "cli": "npm run start -w @yinghuo/cli --",
    "api": "npm run start -w @yinghuo/api",
    "api:dev": "npm run start:dev -w @yinghuo/api",
    "web": "npm run dev -w @yinghuo/web",
    "start": "npm run demo",
    "test:relay": "npm test -w @yinghuo/relay",
    "test:relay:live": "npm run test:live -w @yinghuo/relay"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
