{
  "name": "dtn-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Educational DTN demo — dual-relay NestJS daemons + CLI/SDK + Next.js + K8s sketches",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @dtn-demo/core && npm run build -w @dtn-demo/sdk && npm run build -w @dtn-demo/relay && npm run build -w @dtn-demo/api && npm run build -w @dtn-demo/web",
    "demo": "npm run demo -w @dtn-demo/core",
    "demo:plan": "npm run demo:plan -w @dtn-demo/core",
    "relay:earth": "npm run start:earth -w @dtn-demo/relay",
    "relay:relay": "npm run start:relay -w @dtn-demo/relay",
    "relay:mars": "npm run start:mars -w @dtn-demo/relay",
    "cli": "npm run start -w @dtn-demo/cli --",
    "api": "npm run start -w @dtn-demo/api",
    "api:dev": "npm run start:dev -w @dtn-demo/api",
    "web": "npm run dev -w @dtn-demo/web",
    "start": "npm run demo",
    "test:relay": "npm test -w @dtn-demo/relay"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
